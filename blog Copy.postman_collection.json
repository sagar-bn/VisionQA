              "    const random1 = Math.floor(Math.random() * 10000);\r",
              "    const random2 = Math.floor(Math.random() * 10000);\r",
              "\r",
              "    const str1 = `Title${random1}`;\r",
              "    const str2 = `content${random2}`;\r",
              "\r",
              "    pm.environment.set(\"title\", str1);\r",
              "    pm.environment.set(\"content\", str2);\r",
              "}\r",
              "\r",
              "generateStrings();\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
